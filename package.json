{
  "name": "streaming-gltf",
  "version": "2.0.31",
  "description": "Cluster-LOD glTF renderer: UV-aware spatial meshlet clusters with per-cluster hierarchical LODs in one EXT_meshopt_compression GLB (EP_cluster_lod extras), drawn per-cluster via geometry-grouped drawElements with optional GPU occlusion-query culling. Bake with tools/bake-cluster.mjs.",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "module": "./index.js",
  "exports": {
    ".": "./index.js",
    "./model-pool": "./examples/local-progressive/model-pool.js",
    "./draco-loader": "./examples/local-progressive/draco-loader.js",
    "./cluster-lod-mesh": "./examples/local-progressive/cluster-lod-mesh.js",
    "./meshlet-codec": "./examples/local-progressive/meshlet-codec.js",
    "./occlusion-query-tier": "./examples/local-progressive/occlusion-query-tier.js",
    "./bake": "./tools/bake-cluster.mjs"
  },
  "files": [
    "index.js",
    "examples/local-progressive/*.js",
    "tools/*.mjs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnEntrypoint/streaming-gltf.git"
  },
  "homepage": "https://anentrypoint.github.io/streaming-gltf/",
  "scripts": {
    "test": "node test.js",
    "bake": "node tools/bake-cluster.mjs",
    "bake:corpus": "node tools/bake-cluster-corpus.mjs",
    "demo:local": "node examples/local-progressive/serve.mjs",
    "measure": "node examples/local-progressive/measure-fps.mjs"
  },
  "peerDependencies": {
    "@pixiv/three-vrm": ">= 3.0.0",
    "three": ">= 0.160.0"
  },
  "optionalDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "draco3dgltf": "^1.5.7",
    "ktx2-encoder": "^0.5.3",
    "meshoptimizer": "^1.1.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.3.0",
    "@gltf-transform/extensions": "^4.3.0",
    "@gltf-transform/functions": "^4.3.0",
    "draco3dgltf": "^1.5.7",
    "ktx2-encoder": "^0.5.3",
    "meshoptimizer": "^1.1.1",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "three": ">= 0.160.0"
  }
}
